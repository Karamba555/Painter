# Put secrets in the hosting provider's secret manager. Never commit a real .env.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
APPLE_ENVIRONMENT=Sandbox
APPLE_BUNDLE_ID=com.karamba555.painter
APPLE_PRODUCT_ID=com.karamba555.painter.pro.weekly
APPLE_APP_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_SIGNING_KEY_PATH=/run/secrets/apple-signing-key.p8
APPLE_ROOT_CA_DIR=/run/secrets/apple-root-certificates
DATABASE_PATH=/data/trace-studio.sqlite
AI_WEEKLY_LIMIT=10
AI_DAILY_BUDGET=100
AI_MAX_CONCURRENT=2
HOST=0.0.0.0
PORT=8080
